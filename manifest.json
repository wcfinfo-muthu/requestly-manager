{
    "manifest_version": 3,
    "name": "Requestly: Browser Request Controller",
    "version": "1.0.0",
    "description": "A developer tool to control browser requests with redirect, replace, block, and rewrite rules using wildcard and Regex matching.",
    "icons": {
        "16": "icons/app16.png",
        "32": "icons/app32.png",
        "48": "icons/app48.png",
        "128": "icons/app128.png"
    },
    "action": {
        "default_popup": "src/ui/popup.html",
        "default_icon": {
            "16": "icons/app16.png",
            "32": "icons/app32.png",
            "48": "icons/app48.png",
            "128": "icons/app128.png"
        },
        "default_title": "Requestly: Browser Request Controller"
    },
    "options_ui": {
        "page": "index.html",
        "open_in_tab": true
    },
    "oauth2": {
        "client_id": "19796297908-2tqntf8lsoulqqrc47orh1cihj3v8qpb.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file",
            "https://www.googleapis.com/auth/userinfo.email"
        ]
    },
    "background": {
        "service_worker": "src/background/service-worker.js",
        "type": "module"
    },
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "storage",
        "activeTab",
        "downloads",
        "identity"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_static",
                "enabled": false,
                "path": "rules_static.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "src/content.css"
            ],
            "js": [
                "src/config.js",
                "src/content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
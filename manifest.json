{
    "manifest_version": 3,
    "name": "Request URL Rewriter",
    "version": "1.0.0",
    "description": "Rewrite, redirect, and block HTTP request URLs using powerful wildcard rules — your personal Requestly.",
    "icons": {
        "16": "icons/app16.png",
        "32": "icons/app32.png",
        "48": "icons/app48.png",
        "128": "icons/app128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/app16.png",
            "32": "icons/app32.png",
            "48": "icons/app48.png",
            "128": "icons/app128.png"
        },
        "default_title": "Request URL Rewriter"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_static",
                "enabled": false,
                "path": "rules_static.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}